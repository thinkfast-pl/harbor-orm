# This file configures Lombok for the HarborORM project
# See https://projectlombok.org/features/configuration

# Add @lombok.Generated annotation to all generated code
# This allows JaCoCo to automatically exclude Lombok-generated code from coverage reports
lombok.addLombokGeneratedAnnotation = true

# Use Objects.requireNonNull() for @NonNull checks instead of if-statements
# This eliminates false "missed branch" reports in JaCoCo coverage
# (JaCoCo doesn't filter @NonNull if-branches, but method calls have no branches)
lombok.nonNull.exceptionType = JDK
